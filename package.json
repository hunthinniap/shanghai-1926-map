    "@types/adm-zip": "^0.5.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.6.0",
    "jsdom": "^25.0.1",
    "proj4": "^2.15.0",
