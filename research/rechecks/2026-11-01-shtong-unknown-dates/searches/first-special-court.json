      {
        "id": "81324-101323",
        "title": "第七节　涉外案件",
        "displayDate": 1210815699000,
        "txt": "尹奉吉被捕后，被上海<em style=\"color:red\">第一</em><em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>判处死刑。 \n  民国20～22年（1931～1933年），上海<em style=\"color:red\">第一</em><em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>、第二<em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>、上海<em style=\"color:red\">地方法院</em>共计受理<em style=\"color:red\">第一</em>审涉外刑事案件1069件（含旧案20件），审结1042件，案件当事人涉及俄、日、波兰等国家侨民。其间，案件类型以盗窃案为最多，其次是伤害、诈欺、背信等案件。",
        "txt1": "",
        "txt2": "",
        "txt3": "",
        "siteId": "1",
        "url": "https://www.shtong.gov.cn/difangzhi-front/book/detailNew?oneId=1&bookId=81324&parentNodeId=81394&nodeId=101323&type=-1",
        "attrs": {
