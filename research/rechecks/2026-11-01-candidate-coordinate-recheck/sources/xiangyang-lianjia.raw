<script type="text/template" id="tpl-tabView">
  <%for(var i=0;i<list.length;i++){var item=list[i];%>
    <div class="item">
      <a class="img" href="<%=item.url%>" target="_blank" <%if(item.stat) {%>data-lj_dianji="<%=item.stat%><%}%>">
        <img src="<%=item.head_pic||item.pic||window.default_img_url%>.230x175.jpg" class="lj-lazy" alt="<%=item.title||item.long_title%>">
        <%if(item.label) {%>
          <span class="label"><%=item.label%></span>
        <%}%>
      </a>
      <div class="text">
        <a class="tit" href="<%=item.url%>" target="_blank" <%if(item.stat) {%>data-lj_dianji="<%=item.stat%><%}%>"><%=item.title||item.long_title%></a>
        <p class="summary"><%=item.desc||item.summary||item.content.substring(0, 30)%></p>
        <p class="info">
          <span class="time"><%=item.ctime||item.publish_time%></span>
        </p>
        <%if(item.tags) {%>
          <div class="topic">
            <%for(var i2=0;i2<item.tags.length;i2++) {var item2=item.tags[i2];%>
              <a href="<%=item2.url%>" target="_blank" class="item-topic"><%=item2.name%></a>
            <%}%>
          </div>
        <%}%>
      </div>
    </div>
  <%}%>
</script>





