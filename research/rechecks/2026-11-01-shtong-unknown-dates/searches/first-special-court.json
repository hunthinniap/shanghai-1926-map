      {
        "id": "81324-101239",
        "title": "第六节　江苏上海<em style=\"color:red\">第一</em><em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>和江苏高等法院第二分院",
        "displayDate": 1210729209000,
        "txt": "&lt; xml:namespace prefix = o ns = \"urn:schemas-microsoft-com:office:office\" /&gt; \n  江苏上海<em style=\"color:red\">第一</em><em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>（内附检察处）成立之初，原名为江苏上海<em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>。民国20年（1931年）8月1日，上海法租界内成立江苏上海第二<em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>后，江苏上海<em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>改称江苏上海<em style=\"color:red\">第一</em><em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>。",
        "txt1": "",
