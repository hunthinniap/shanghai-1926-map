          "bookId": "81324"
        },
        "businessType": "Book",
        "contentCreateDate": "2008-05-14 09:40:38",
        "contentUpdateDate": "2008-05-14 09:40:38"
      },
      {
        "id": "81324-101278",
        "title": "<em style=\"color:red\">第一</em>节　民事审判制度、程序",
        "displayDate": 1210730115000,
        "txt": "在<em style=\"color:red\">第一</em>审诉讼中，有和解希望时，由推事试行和解。民国3～12年（1914～1923年），上海地方审判厅一审和解3669件，占同期结案总数20．28%。民国1～25年，上海<em style=\"color:red\">地方法院</em>（含<em style=\"color:red\">特区</em>法院）受理民事调解事件101524件，终结101415件。民国18～29年，上海<em style=\"color:red\">地方法院</em>（含<em style=\"color:red\">特区</em>法院）一审民事案件和解15552件，占同期结案总数13．28%。",
        "txt1": "",
        "txt2": "",
        "txt3": "",
