          "bookId": "4516"
        },
        "businessType": "Book",
        "contentCreateDate": "2002-12-30 10:56:18",
        "contentUpdateDate": "2002-12-30 10:56:18"
      },
      {
        "id": "4516-42324",
        "title": "第三章　净<em style=\"color:red\">水厂</em>",
        "displayDate": 1041215984000,
        "txt": "1995年底，上海在<em style=\"color:red\">杨树</em><em style=\"color:red\">浦</em>、南市、长桥、闸北、浦东、闵行、吴淞、月浦和凌桥等地有13座市级自来<em style=\"color:red\">水厂</em>，日供水能力557万立方米，最大日供水量571万立方米。 \n  60年代开始发展企业自备<em style=\"color:red\">水厂</em>，70年代上海石化厂和宝山钢铁厂引进国外先进设施，净水和管理水平较高。1995年，日供水量超过1万立方米的自备<em style=\"color:red\">水厂</em>有46家。",
        "txt1": "",
        "txt2": "",
        "txt3": "",
        "siteId": "1",
