{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shanghai undated-event external research result",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "batch_id", "input_sha256", "researcher", "completed_on", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"const": "shanghai-unknown-dates-2026-11-02"},
    "batch_id": {"type": "string", "pattern": "^date-agent-[0-9]{3}$"},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "researcher": {"type": "string"},
    "completed_on": {"type": ["string", "null"], "format": "date"},
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "date": {
      "type": "object",
      "required": ["text", "year", "end_year", "month", "day", "precision", "qualifier"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "year": {"type": ["integer", "null"], "minimum": 1000, "maximum": 2100},
        "end_year": {"type": ["integer", "null"], "minimum": 1000, "maximum": 2100},
        "month": {"type": ["integer", "null"], "minimum": 1, "maximum": 12},
        "day": {"type": ["integer", "null"], "minimum": 1, "maximum": 31},
        "precision": {"enum": ["day", "month", "year", "decade", "range", "unknown"]},
        "qualifier": {"enum": ["exact", "circa", "before", "after", "unspecified"]}
      }
    },
    "finding": {
      "type": "object",
      "required": ["name", "address", "date_type", "date", "identity_scope", "address_match", "identity_evidence", "source_ids", "caveat"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "address": {"type": "string", "minLength": 1},
        "date_type": {"enum": ["construction", "completion", "reconstruction", "alteration", "opening", "move_in", "rename", "documented_use", "historical_name"]},
        "date": {"$ref": "#/$defs/date"},
        "identity_scope": {"enum": ["same_building", "building_component", "same_site", "institution_only", "unverified"]},
        "address_match": {"enum": ["explicit_same_address", "verified_renumbering", "site_only", "not_established"]},
        "identity_evidence": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "caveat": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": ["source_id", "title", "url", "publisher", "source_type", "accessed_on", "read_full_text", "section_or_page", "short_quote", "supports"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://"},
        "publisher": {"type": "string"},
        "source_type": {"enum": ["gazetteer", "archive", "official_institution", "scholarly", "press", "other"]},
        "accessed_on": {"type": "string", "format": "date"},
        "read_full_text": {"type": "boolean"},
        "section_or_page": {"type": "string"},
        "short_quote": {"type": "string"},
        "supports": {"type": "string", "minLength": 1}
      }
    },
    "search": {
      "type": "object",
      "required": ["query", "entry_or_domain", "opened_urls", "outcome", "access_issue"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "entry_or_domain": {"type": "string", "minLength": 1},
        "opened_urls": {"type": "array", "items": {"type": "string", "pattern": "^https?://"}},
        "outcome": {"type": "string", "minLength": 1},
        "access_issue": {"type": ["string", "null"]}
      }
    },
    "result": {
      "type": "object",
      "required": ["task_id", "task_fingerprint", "status", "summary", "recommended_action", "findings", "sources", "searches", "remaining_questions"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["verified", "range_only", "partial", "candidate", "conflict", "not_found", "insufficient_identity", "access_blocked", "not_researched"]},
        "summary": {"type": "string", "minLength": 1},
        "recommended_action": {"enum": ["add_dated_use_event", "set_construction_date", "add_range_note", "retain_unknown"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "searches": {"type": "array", "items": {"$ref": "#/$defs/search"}},
        "remaining_questions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
