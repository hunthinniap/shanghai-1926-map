      {
        "id": "81324-101232",
        "title": "<em style=\"color:red\">第一</em>编　机构",
        "displayDate": 1210729107000,
        "txt": "11月1日，江苏上海地方审判厅、检察厅改组为江苏上海<em style=\"color:red\">地方法院</em>和检察处。民国19年4月1日，撤销上海公共租界临时法院及上诉院，成立江苏上海<em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>（后改为<em style=\"color:red\">第一</em><em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>）及江苏高等法院第二分院（内均附检察处）。民国19年，江苏上海<em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>对司法警察的工作职责作了详细规定。民国20年8月1日，在法租界设立江苏上海第二<em style=\"color:red\">特区</em><em style=\"color:red\">地方法院</em>和江苏高等法院第三分院。",
        "txt1": "",
        "txt2": "",
        "txt3": "",
        "siteId": "1",
        "url": "https://www.shtong.gov.cn/difangzhi-front/book/detailNew?oneId=1&bookId=81324&parentNodeId=81329&nodeId=81343&type=0",
